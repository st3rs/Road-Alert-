{
  "compilerOptions": {
    "outDir": "build",
    "target": "es2024",
    "module": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "sourceMap": true,
    "importHelpers": true,
    "types": ["dom-speech-recognition", "node", "google.maps"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types.d.ts"]
}
